    "homebridge-plugin",
    "homebridge",
    "homekit",
    "linksys",
    "velop",
    "mx4200",
    "mesh",
    "router",
    "parental-controls",
    "parental control",
    "presence"
  ],
  "engines": {
    "node": "^18.20.4 || ^20.15.1 || ^22 || ^24",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
